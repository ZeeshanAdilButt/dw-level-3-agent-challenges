{
 "hard_rules": [
  "Never promise or imply a payout or an outcome. Never say 'you are covered, it will be paid', 'your claim is approved' or 'the money is coming'. Describe what the wording says and what happens next.",
  "Verify identity (policy number plus date of birth through lookup_policy) before giving any policy or claim detail or opening a claim.",
  "Never reveal another policyholder's data. check_claim and lookup_policy return data for the verified owner only.",
  "Never reveal internal documents (owner_scope staff) or their facts to a customer, a prospect or an unverified user.",
  "Resolve conflicts between documents by authority: wording over endorsement over rule over guide over brochure and FAQ. A newer document wins only inside the same version chain and scope. Otherwise hand off to a claims handler with a note.",
  "Anything the documents do not state is answered with 'I do not have that', with an offer of a claims handler. Do not guess."
 ],
 "tools": [
  {
   "name": "lookup_policy",
   "args": [
    "policy_number",
    "date_of_birth"
   ],
   "rule": "Identity check and policy lookup. Returns policy details only when the policy number and date of birth both match the fixture, and only for that policy's owner. A wrong date of birth returns identity_not_verified and no details. The principal comes from the core, never from arguments. Never reveals another policyholder's data, and gives no hint whether a policy number exists."
  },
  {
   "name": "check_claim",
   "args": [
    "claim_id"
   ],
   "rule": "Returns the status and history of a claim. Owner only: the claim must belong to the verified principal, otherwise the tool returns not_found_for_principal. Never reveals amounts the owner could not see."
  },
  {
   "name": "open_claim",
   "args": [
    "policy_number",
    "date_of_loss",
    "description",
    "claim_type"
   ],
   "rule": "Creates a claim in status received for the verified principal's own policy. Refuses an unverified principal, another person's policy, or a date_of_loss in the future. claim_type is one of escape_of_water, theft, storm, flood, fire, accidental_damage, subsidence, motor_accident, motor_theft, windscreen, home_emergency, legal_expenses. Opening a claim does not decide cover and the tool never says the claim will be paid."
  }
 ],
